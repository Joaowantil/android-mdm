# =============================================================================
# Arezzo Device Manager: variáveis do Docker Compose
#
#   cp .env.example .env
#   chmod 600 .env          # só o dono lê: este arquivo tem segredos
#
# O .env NUNCA vai para o Git (já está no .gitignore).
# =============================================================================

# --- OBRIGATÓRIAS ---------------------------------------------------------------
# Gere cada valor com:   openssl rand -hex 32
# Use SÓ letras e números (hex): a senha do banco entra dentro de uma URL e caracteres
# especiais (@ : / # %) a quebrariam.
POSTGRES_PASSWORD=
SECRET_KEY=

# Senha do administrador inicial (admin@mdm.local). Só vale na PRIMEIRA subida com o banco
# VAZIO; ao restaurar um dump (já existem usuários) é ignorada, mas precisa estar preenchida.
# Mínimo 8 caracteres; a API recusa subir com menos. Troque no primeiro acesso.
INITIAL_ADMIN_PASSWORD=

# --- PORTAS (no servidor) -----------------------------------------------------------
# Painel e API. Se a 80 já estiver em uso, mude aqui.
HTTP_PORT=80
# Porta antiga, para os aparelhos já instalados com http://IP:8000 gravado no app.
# Tem que ser diferente de HTTP_PORT.
LEGACY_API_PORT=8000

# --- OPCIONAIS ------------------------------------------------------------------
# Duração do login no painel, em minutos (480 = 8 horas)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Limites de memória por container
BACKEND_MEM_LIMIT=512m
DB_MEM_LIMIT=1g
WEB_MEM_LIMIT=128m

# Faixas das redes internas do Docker (veja o README, "Conflito de rede"). Só mude se
# 198.18.40.0/24 ou 198.18.41.0/24 já forem usadas na sua rede.
MDM_WEB_SUBNET=198.18.40.0/24
MDM_DB_SUBNET=198.18.41.0/24
